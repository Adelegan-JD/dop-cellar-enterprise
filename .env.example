# ---------------------------------------------------------------------------
# Dop Cellar Global Limited — environment variable template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development. Do NOT commit `.env*`
# files containing real secrets — only `.env.example` is tracked.
#
# Two flavors of variables exist:
#
#   VITE_*    → Inlined into the client bundle at BUILD time. Safe to expose
#               publicly (URLs, anon/publishable keys). Read with
#               `import.meta.env.VITE_FOO`.
#
#   Anything  → Server-only. Read at RUNTIME via `process.env.FOO` inside
#   else        server-function `.handler()` bodies or server route handlers.
#               NEVER reference `process.env.X` at module scope — Vite cannot
#               replace it and the value will be `undefined` in the browser.
#
# Where to configure these in production:
#
#   Vercel  → Project → Settings → Environment Variables
#             (set per environment: Production / Preview / Development)
#   Docker  → `docker run -e KEY=value ...` or an `--env-file .env.production`
#   GH CI   → Repository → Settings → Secrets and variables → Actions
# ---------------------------------------------------------------------------


# --- Public site config (client-visible) -----------------------------------
VITE_SITE_URL="https://www.dopcellarglobal.com"


# --- Lovable Cloud / Supabase (enable when backend features are added) ----
# Publishable (anon) key — safe to expose to the browser. RLS still applies.
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. BYPASSES RLS — only used inside server functions / API routes.
# SUPABASE_URL=""
# SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""


# --- WhatsApp Cloud API (for future contact / lead webhooks) --------------
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""


# --- AI Gateway / model providers (for future AI features) ----------------
# LOVABLE_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""


# --- Email / transactional (for the contact form once wired up) -----------
# RESEND_API_KEY=""
# CONTACT_INBOX="info@dopcellarglobal.com"


# --- Payments (Stripe / Paddle — only when invoicing/checkout is added) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""


# --- Runtime tuning --------------------------------------------------------
# PORT=3000
# NODE_ENV=production
# NITRO_PRESET=node-server   # set by the Dockerfile; only override if needed
